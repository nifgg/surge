#!name=微信公众号去广告
#!desc=过滤微信公众号广告
#!version=1.0.3
#!author=RuCu6[https://github.com/RuCu6]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weixin.png
#!category=去广告
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

# Surge adaptation; upstream authorship retained above.
# source-date=2026-10-02 13:57:49
# adapter-version=1.4.0

[Rule]
DOMAIN-SUFFIX,wxs.qq.com,REJECT

[Map Local]
(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% mp.weixin.qq.com
