#!name=微博去广告
#!desc=过滤微博广告及去除各部分推广模块
#!version=1.0.9
#!author=RuCu6[https://github.com/RuCu6], zmqcherish[https://github.com/zmqcherish]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weibo.png
#!category=去广告
#!homepage=https://hub.kelee.one
#!date=2026-10-02 13:57:49

# Surge adaptation; upstream authorship retained above.
# source-date=2026-10-02 13:57:49
# adapter-version=1.5.0

[Rule]
DOMAIN-SUFFIX,uve.weibo.com,DIRECT
DOMAIN,huodong.weibo.cn,REJECT
DOMAIN-SUFFIX,biz.weibo.com,REJECT

[Map Local]
(?i)^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/photo\/info\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_discover|finder_nav_polling)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

(?i)^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
微博·首页推广 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/(?:checkin\/show|client\/publisher_list|push\/active), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·首页顶部标签 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/groups\/allgroups\/v2\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·卡片信息流 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/(?:cardlist|page), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·评论列表 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·个人微博详情页广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/(?:container\/asyn|flowlist|flowpage), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·关注操作弹窗 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/friendships\/(?:create|destroy), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·个人主页广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/profile\/(?:container_timeline|dealatt|me|statuses\/tab|userinfo), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·超话搜索页广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·展开评论 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:comments_expand_child|container_detail_comment), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·微博信息流 = type=http-response, pattern=^(?!(?:(?i:^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info))))(?i:^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline)), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·微博详情页广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:extend|show)\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·视频流广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/video\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·超话顶部标签 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·消息页列表广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·消息页提醒 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/messageflow\/notice\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·热门微博信息流广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_timeline|finder)\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·发现页搜索结果广告 = type=http-response, pattern=(?i)^https:\/\/api\.weibo\.cn\/2\/searchall\?, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·开屏预加载 = type=http-response, pattern=(?i)^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·开屏配置 = type=http-response, pattern=(?i)^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php, script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview
微博·开屏下发 = type=http-response, pattern=(?i)^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua), script-path=https://raw.githubusercontent.com/nifgg/surge/refs/heads/main/scripts/weibo/weibo.js, requires-body=true, max-size=-1, timeout=20, engine=webview

[MITM]
hostname = %APPEND% *.weibo.cn, *.weibo.com, weibo.com
